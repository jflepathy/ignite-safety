# --- Database (Supabase/PostgreSQL) ---
# Use the Supabase "connection pooling" URI for DATABASE_URL (pgbouncer, port 6543)
# and the direct connection for DIRECT_URL (port 5432) so Prisma migrations work.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ignite_safety"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/ignite_safety"

# --- Auth ---
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-string"

# --- App ---
NEXT_PUBLIC_APP_NAME="Ignite Safety"
